
        /* ===== RESET & BASE ===== */
        
:root {
    /* ═══ لوحة الألوان الموحدة — عدّل هنا لتغيير هوية المنصة كاملة ═══ */
    --gold: #cfa776;
    --gold-deep: #b48554;
    --gold-bright: #d4b15a;
    --bg: #0b0e17;
    --bg-2: #121824;
    --text: #f0f4fa;
    --text-muted: #b8c5dc;   /* مفتّح عن السابق لتحسين تباين النصوص الصغيرة */
    --danger: #dc3545;
    --danger-soft: #f87171;
    --success: #28a745;
    --warning: #ffc107;
    /* ═══ مقياس الانحناء الموحد (4 قيم فقط) ═══ */
    --radius-xs: 4px;
    --radius-sm: 10px;
    --radius-md: 20px;
    --radius-lg: 30px;
    --radius-xl: 40px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%; max-width: 100vw; overflow-x: hidden;
            font-family: 'Tajawal', sans-serif;
            background: var(--bg); color: var(--text);
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            min-height: 100vh;
            padding: 1rem;
        }

        /* ===== إزالة كل ما يسبب الاهتزاز ===== */
        .container, header, .search-wrapper, .tool-card, .back-btn,
        .tool-content, .no-results, footer, .collapsible-header {
            transform: none !important;
            -webkit-transform: none !important;
            will-change: auto !important;
            backface-visibility: visible !important;
            -webkit-backface-visibility: visible !important;
            animation: none !important;
            transition: none !important;
        }

        /* ===== خلفية ثابتة ===== */
        body::before {
            content: ''; position: fixed; inset: 0;
            background: radial-gradient(circle at 70% 30%, #141c2b, #0a0e16);
            z-index: -1;
        }

        /* ===== الحاوية ===== */
        .container {
            max-width: 1100px; margin: 0 auto;
            position: relative; z-index: 1;
        }

        /* ===== الهيدر ===== */
        header {
            text-align: center;
            margin-bottom: 1.5rem;
            padding-top: 0.5rem;
        }
        header h1 {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--gold-bright);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        header h1 i { color: var(--gold-deep); }
        header p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-top: 0.3rem;
        }

        /* ===== زر العودة ===== */
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: rgba(180,133,84,0.12);
            border: 2px solid rgba(180,133,84,0.2);
            border-radius: var(--radius-xl);
            padding: 0.4rem 1.2rem;
            color: var(--gold);
            font-weight: 700;
            font-size: 0.9rem;
            text-decoration: none;
            margin-bottom: 1rem;
        }
        .back-btn:hover { background: rgba(180,133,84,0.25); border-color: var(--gold-deep); }
        .back-btn i { color: var(--gold-deep); }

        /* ===== البحث ===== */
        .search-wrapper {
            position: relative;
            max-width: 100%;
            margin: 0.8rem auto 1.5rem;
        }
        .search-wrapper i {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: var(--gold-deep);
            font-size: 1rem;
            pointer-events: none;
        }
        #searchInput {
            width: 100%;
            padding: 0.8rem 3rem 0.8rem 1.2rem;
            border-radius: var(--radius-xl);
            border: 2px solid rgba(180,133,84,0.2);
            background: rgba(18,24,36,0.8);
            backdrop-filter: blur(8px);
            color: var(--text);
            font-family: 'Tajawal', sans-serif;
            font-size: 1rem;
            outline: none;
        }
        #searchInput:focus {
            border-color: var(--gold-deep);
            box-shadow: 0 0 0 3px rgba(180,133,84,0.15);
            background: rgba(22,30,46,0.9);
        }
        #searchInput::placeholder {
            color: #6a7a8e;
        }

        /* ===== شبكة الأدوات ===== */
        .tools-grid {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        /* ===== بطاقة الأداة (قابلة للطي) ===== */
        .tool-card {
            background: rgba(22,30,46,0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(180,133,84,0.15);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: 0 8px 20px -8px rgba(0,0,0,0.4);
        }
        .tool-card:hover {
            border-color: rgba(180,133,84,0.3);
        }

        .collapsible-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.2rem;
            cursor: pointer;
            gap: 0.8rem;
            user-select: none;
            background: rgba(15,20,30,0.3);
        }
        .collapsible-header h2 {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--gold);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex: 1;
        }
        .collapsible-header h2 i {
            color: var(--gold-deep);
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        .collapsible-header .toggle-icon {
            color: var(--text-muted);
            font-size: 1.2rem;
            flex-shrink: 0;
            transition: transform 0.15s;
        }
        .collapsible-header .toggle-icon.open {
            transform: rotate(180deg);
        }

        .tool-content {
            padding: 0 1.2rem 1.2rem;
            color: #d0d9e8;
            font-size: 0.95rem;
            line-height: 1.8;
            display: none;
            white-space: pre-wrap;
            overflow-x: auto;
        }
        .tool-content.open {
            display: block;
        }

        .tool-content h3 {
            font-size: 1.1rem;
            margin: 1.2rem 0 0.6rem;
            color: #e2c5a3;
        }
        .tool-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 0.6rem 0;
            font-size: 0.85rem;
            background: rgba(10,14,23,0.4);
            border-radius: var(--radius-sm);
            overflow: hidden;
        }
        .tool-content th,
        .tool-content td {
            border: 1px solid rgba(180,133,84,0.15);
            padding: 0.4rem 0.6rem;
            text-align: right;
        }
        .tool-content th {
            background: rgba(180,133,84,0.1);
            color: #f0e6d2;
            font-weight: 700;
        }
        .tool-content td {
            color: #d0d9e8;
        }

        /* ===== لا توجد نتائج ===== */
        .no-results {
            text-align: center;
            font-size: 1.1rem;
            color: var(--text-muted);
            margin-top: 2rem;
            display: none;
        }
        .no-results i {
            color: var(--gold-deep);
            margin-left: 0.5rem;
        }

        /* ===== الفوتر ===== */
        footer {
            text-align: center;
            color: var(--text-muted);
            margin-top: 2rem;
            font-size: 0.8rem;
            padding-bottom: 0.5rem;
        }
        footer span {
            color: var(--gold);
            font-weight: 700;
        }

        /* ===================================================
           تحسينات الجوال
           =================================================== */
        @media (max-width: 768px) {
            body { padding: 0.8rem; }
            header h1 { font-size: 1.5rem; }
            header p { font-size: 0.85rem; }
            .back-btn { font-size: 0.8rem; padding: 0.3rem 1rem; }
            #searchInput { font-size: 0.9rem; padding: 0.7rem 2.8rem 0.7rem 1rem; }
            .collapsible-header { padding: 0.8rem 1rem; }
            .collapsible-header h2 { font-size: 1rem; }
            .collapsible-header h2 i { font-size: 1rem; }
            .tool-content { font-size: 0.9rem; padding: 0 0.8rem 0.8rem; }
            .tool-content table { font-size: 0.8rem; }
            .tool-content th, .tool-content td { padding: 0.3rem 0.5rem; }
        }

        @media (max-width: 400px) {
            header h1 { font-size: 1.2rem; }
            .collapsible-header h2 { font-size: 0.9rem; flex-wrap: wrap; }
            .collapsible-header .toggle-icon { font-size: 1rem; }
            .tool-content { font-size: 0.85rem; }
        }
    
